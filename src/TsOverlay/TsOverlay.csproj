<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Só para o NotifyIcon da bandeja -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Permite compilar fora do Windows (CI e Linux); o app só roda no Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>TsOverlay</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Evita conflito de nomes entre WPF e WinForms (Application, Button, Brush...) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Main próprio em Program.cs: o Velopack precisa rodar antes de tudo -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TsOverlay.Core\TsOverlay.Core.csproj" />
  </ItemGroup>

</Project>
