<Window x:Class="TsOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TsOverlay"
        Title="TS Overlay"
        Width="260" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Foreground="#DBDEE1" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <!-- Sem fundo, o texto precisa de um contorno escuro para ler sobre qualquer jogo -->
        <DropShadowEffect x:Key="TextOutline" Color="Black" ShadowDepth="0" BlurRadius="4" Opacity="1" />
        <local:AvatarConverter x:Key="Avatar" />

        <!-- Item da lista: foto + nome, com ícones de mute. Como no TS, quem fala ganha um anel azul na foto -->
        <DataTemplate x:Key="ClientTemplate">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="28" Height="28" Margin="0,0,8,0">
                    <!-- Sem foto do myTeamSpeak fica a silhueta padrão do TS -->
                    <Ellipse Width="22" Height="22" Fill="#4E5058" />
                    <!-- Segoe MDL2 Assets: E77B = pessoa -->
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#B5BAC1"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Width="22" Height="22" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                           Source="{Binding AvatarUrl, Converter={StaticResource Avatar}}">
                        <Image.Clip>
                            <EllipseGeometry Center="11,11" RadiusX="11" RadiusY="11" />
                        </Image.Clip>
                    </Image>
                    <Ellipse x:Name="TalkRing" Width="28" Height="28" Stroke="Transparent" StrokeThickness="2" />
                </Grid>
                <TextBlock x:Name="Name" Grid.Column="1" Text="{Binding Nickname}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- Segoe MDL2 Assets: E720 = microfone, E74F = som mutado -->
                    <TextBlock x:Name="MicMuted" Text="&#xE720;" FontFamily="Segoe MDL2 Assets" Foreground="#F23F43"
                               Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Microfone mutado" />
                    <TextBlock x:Name="SoundMuted" Text="&#xE74F;" FontFamily="Segoe MDL2 Assets" Foreground="#F23F43"
                               Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Som mutado" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsTalking}" Value="True">
                    <Setter TargetName="TalkRing" Property="Stroke" Value="#2D8CFF" />
                    <Setter TargetName="Name" Property="Foreground" Value="#FFFFFF" />
                    <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMe}" Value="True">
                    <Setter TargetName="Name" Property="FontStyle" Value="Italic" />
                </DataTrigger>
                <DataTrigger Binding="{Binding InputMuted}" Value="True">
                    <Setter TargetName="MicMuted" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OutputMuted}" Value="True">
                    <Setter TargetName="SoundMuted" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- Travado fica só o texto; destravado ganha fundo para dar onde clicar e arrastar -->
    <Border x:Name="Card" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
            MouseLeftButtonDown="Card_MouseLeftButtonDown" MouseWheel="Card_MouseWheel">
        <StackPanel Margin="12,8,12,10">
            <!-- Só aparece destravado: dica de uso e botão de fechar -->
            <Grid x:Name="UnlockedHeader" Margin="0,0,0,6">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock x:Name="HelpText" Foreground="#949BA4" FontSize="11" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Atalho:" Foreground="#949BA4" FontSize="11" VerticalAlignment="Center" />
                        <Button x:Name="HotkeyButton" Click="HotkeyButton_Click" ToolTip="Clique para escolher outro atalho"
                                Margin="6,0,0,0" Padding="6,1" FontSize="11" Foreground="#DBDEE1"
                                Background="#33FFFFFF" BorderBrush="#5865F2" Cursor="Hand" Focusable="False" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="CloseButton" Content="✕" Click="CloseButton_Click" ToolTip="Ocultar (o TS Overlay continua na bandeja)"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Width="18" Height="18" Padding="0"
                        FontSize="11" Foreground="#949BA4" Background="Transparent" BorderThickness="0" Cursor="Hand" />
            </Grid>
            <StackPanel Effect="{StaticResource TextOutline}">
                <TextBlock x:Name="StatusText" Foreground="#B5BAC1" FontSize="12" TextWrapping="Wrap" />
                <ItemsControl x:Name="ClientList" ItemTemplate="{StaticResource ClientTemplate}" />
                <!-- Último que saiu do canal: apagado e riscado -->
                <Grid x:Name="LastLeftRow" Margin="0,1" Opacity="0.45" ToolTip="Último que saiu do canal">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="28" Height="28" Margin="0,0,8,0">
                        <Ellipse Width="22" Height="22" Stroke="#80848E" StrokeThickness="1.5" />
                    </Grid>
                    <TextBlock x:Name="LastLeftName" Grid.Column="1" TextDecorations="Strikethrough" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
